# Which language model to use: gemini (free tier), openai or anthropic
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash
GOOGLE_API_KEY=put-your-gemini-key-here

# Backup model: used automatically when the main model fails
FALLBACK_PROVIDER=ollama
FALLBACK_MODEL=llama3.1:8b

# LangSmith tracing
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=put-your-langsmith-key-here
LANGSMITH_PROJECT=asterline-assistant
LANGSMITH_ENDPOINT=https://apac.api.smith.langchain.com